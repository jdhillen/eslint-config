{
  "name": "@jdhillen/eslint-config",
  "version": "2.0.0",
  "description": "ESLint configuration for Vue.js and TypeScript projects",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "files": [
    "src/**",
    "bin/**",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "setup-eslint-config": "./bin/setup-eslint-config.js"
  },
  "author": {
    "name": "J.D. Hillen",
    "email": "jhillen01@gmail.com",
    "url": "https://links.jdhillen.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdhillen/eslint-config.git"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "vue",
    "typescript",
    "jdhillen"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "commit": "cz",
    "test": "echo \"No tests specified\"",
    "release": "semantic-release",
    "semantic-release": "semantic-release",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@eslint/js": "^9.21.0",
    "@jdhillen/release-config": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-vue": "^10.0.0",
    "vue-eslint-parser": "^10.1.1"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0",
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
