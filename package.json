{
  "name": "@jdhillen/eslint-config",
  "version": "2.0.0",
  "description": "Universal ESLint configuration for React, Vue, Svelte, Solid, Astro, Angular, and TypeScript projects with auto-detection",
  "license": "MIT",
  "author": {
    "name": "J.D. Hillen",
    "email": "jhillen01@gmail.com",
    "url": "https://links.jdhillen.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdhillen/eslint-config.git"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "react",
    "vue",
    "svelte",
    "solid",
    "astro",
    "angular",
    "typescript",
    "javascript",
    "auto-detect",
    "universal",
    "jdhillen"
  ],
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "setup-eslint-config": "bin/setup-eslint-config.js"
  },
  "files": [
    "src/**",
    "bin/**",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "node tests/detectors.test.js",
    "commit": "cz",
    "release": "semantic-release",
    "prepare": "husky"
  },
  "dependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.37.0",
    "@jdhillen/release-config": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^9.37.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-solid": "^0.14.5",
    "eslint-plugin-svelte": "^3.12.4",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.4.0",
    "svelte-eslint-parser": "^1.3.3",
    "typescript-eslint": "^8.46.0",
    "vue-eslint-parser": "^10.2.0"
  },
  "peerDependencies": {
    "astro": ">=3.0.0 || >=4.0.0 || >=5.0.0",
    "solid-js": ">=1.0.0",
    "svelte": ">=3.0.0 || >=4.0.0 || >=5.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
